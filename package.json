{
  "name": "guardrail-wallet",
  "version": "0.1.0",
  "description": "Self-hosted guardrail wallet: an AI agent requests payments, hard limits are enforced by local policy, with optional chain-level enforcement.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude scripts/launch-kit.test.mjs",
    "test:watch": "vitest",
    "ton:check": "tsx scripts/ton-check.ts",
    "test:e2e": "playwright test",
    "test:smoke": "bash scripts/smoke.sh",
    "test:all": "npm test && npm run test:e2e && npm run test:smoke",
    "test:launch": "node --test scripts/launch-kit.test.mjs && node scripts/launch-kit.mjs",
    "capture:launch-demo": "node scripts/capture-launch-demo.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "better-sqlite3": "^11.7.0",
    "grammy": "^1.32.0",
    "hono": "^4.6.14",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
