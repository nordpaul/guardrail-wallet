# Copy to .env and fill in. NEVER commit .env.

# HTTP
PORT=8787

# The token your agent sends as: Authorization: Bearer <AGENT_API_KEY>
# This grants the right to REQUEST a payment, not to move money.
AGENT_API_KEY=change-me-to-a-long-random-string

# Owner token for the web dashboard at http://localhost:<PORT>/
# MUST be different from AGENT_API_KEY — the agent must not be able to approve.
# Leave empty to disable the web dashboard entirely.
DASHBOARD_TOKEN=change-me-too-different-from-agent-key

# Storage (SQLite file).
DB_PATH=data/wallet.sqlite

# Spending policy file.
POLICY_PATH=policy.yaml

# Settlement: "stub" (no chain, fake hashes — great for testing) or "ton".
EXECUTOR=stub

# Telegram approvals. Leave TELEGRAM_BOT_TOKEN empty to disable.
# Create a bot with @BotFather, then put the token here.
TELEGRAM_BOT_TOKEN=

# --- TON (only needed when EXECUTOR=ton) ---
TON_NETWORK=testnet
# Toncenter JSON-RPC. Testnet: https://testnet.toncenter.com/api/v2/jsonRPC
# Mainnet: https://toncenter.com/api/v2/jsonRPC  (get a free API key at @tonapibot)
TON_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
TON_API_KEY=
# 24-word mnemonic of the SESSION key — the LIMITED key this server signs with.
# NOT your owner key. Whitespace-separated.
TON_SESSION_MNEMONIC=
# USDT jetton master. Mainnet: EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
TON_USDT_MASTER=
TON_DECIMALS=6
TON_GAS_TON=0.05
